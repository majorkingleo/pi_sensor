; AI generated by pi coding agent, v1.0
;
; Template for the website database credentials.
;
; Copy this file to /etc/pi_sensor/web.ini and fill in the values:
;
;   sudo mkdir -p /etc/pi_sensor
;   sudo cp etc/web.ini.example /etc/pi_sensor/web.ini
;   sudo chown root:www-data /etc/pi_sensor/web.ini
;   sudo chmod 640 /etc/pi_sensor/web.ini
;
; The file must NOT be placed inside www/ - the whole repository is served by
; Apache, so a credential file inside it would be downloadable.
;
; Every value can also be supplied through an environment variable
; (PI_SENSOR_DB_HOST, PI_SENSOR_DB_PORT, PI_SENSOR_DB_DATABASE,
;  PI_SENSOR_DB_USERNAME, PI_SENSOR_DB_PASSWORD), which takes precedence.
;
; Create the database user with read-only access:
;
;   CREATE USER 'pi_sensor_www'@'localhost' IDENTIFIED BY '<secret>';
;   GRANT SELECT ON bleihuetten.measurements TO 'pi_sensor_www'@'localhost';

[database]
host = localhost
port = 3306
database = bleihuetten
username = pi_sensor_www
password = change-me
